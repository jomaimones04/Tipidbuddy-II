{
  "expo": {
    "name": "TipidBuddy",
    "slug": "tipidbuddy",
    "version": "1.0.0",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tipidbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#2D7D46"
      },
      "package": "com.tipidbuddy.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": { "newArchEnabled": true },
          "ios": { "newArchEnabled": true }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "04cdf2e4-1d14-47a3-af0e-c06da60fa166"
      }
    },
    "owner": "m4eca"
  }
}