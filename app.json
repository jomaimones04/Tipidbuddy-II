{
  "expo": {
    "name": "TipidBuddy",
    "slug": "tipidbuddy",
    "version": "1.0.0",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tipidbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#2D7D46"
      },
      "package": "com.tipidbuddy.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "eec09406-6eb0-4e49-8d2b-92b22765b237"
      }
    }
  }
}
