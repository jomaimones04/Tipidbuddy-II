{
  "name": "tipidbuddy",
  "version": "1.0.0",
  "description": "React Native grocery shopping list and budget tracking app",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan --go --clear",
    "start:tunnel": "expo start --tunnel --go --clear",
    "start:dev": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx,json}",
    "eject": "expo eject"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/stack": "^7.10.24",
    "expo": "^57.0.21",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-animatable": "^1.4.0",
    "react-native-chart-kit": "~6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.0",
    "victory-native": "~36.9.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.4",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-voice/voice",
          "@react-native-ml-kit/text-recognition"
        ]
      }
    }
  }
}
